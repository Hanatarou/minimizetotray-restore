{
  "manifest_version": 2,

  "browser_specific_settings": {
    "gecko": {
      "id": "minimizetotray-restore@example.com",
      "strict_min_version": "154.0"
    }
  },

  "name": "__MSG_extensionName__",
  "default_locale": "en-US",
  "description": "__MSG_extensionDescription__",

  "version": "1.0.0",

  "author": "Bruno Eduardo",
  "homepage_url": "https://github.com/Hanatarou/minimizetotray-restore",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "permissions": ["storage"],

  "options_ui": {
    "page": "options/options.html",
    "browser_style": true
  },

  "experiment_apis": {
    "MinimizeToTray": {
      "schema": "api/MinimizeToTray/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["MinimizeToTray"]],
        "script": "api/MinimizeToTray/implementation.js"
      }
    }
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
